rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read and write their own data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Cards they added themselves (small photos), one document each.
      match /custom/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
